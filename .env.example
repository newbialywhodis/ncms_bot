# ── Wymagane ────────────────────────────────────────────────────────────────

# Token bota (Bot → Token w Dev Portal)
DISCORD_TOKEN=

# ID aplikacji (General Information → Application ID)
DISCORD_CLIENT_ID=

# ID serwera Discord (prawy klik na serwer → Kopiuj ID; tryb dewelopera musi być włączony)
DISCORD_GUILD_ID=

# ID roli "gracz" - osoby z tą rolą są śledzone w ankietach i pingowane przez /przypomnij
PLAYER_ROLE_ID=

# ID ról uprawnionych do /ankieta i /przypomnij (można podać kilka, oddzielone przecinkiem)
# np. kapitan, trener, zarząd
ALLOWED_ROLES=

# Mapowanie pozycji na role Discorda, format: kod:roleId,kod:roleId
# Dostepne kody: br,so,lo,po,pp,lp,spd,sp,spo,ls,n,ps
# Przyklad:
# POSITION_ROLE_IDS=br:1234567890,so:2345678901,sp:3456789012
POSITION_ROLE_IDS=br:1481278234975932566, lo:1481278702598885378, so:1481278856215396372, po:1481278964784824410, spd:1481279182649430128, sp:1481278966185721908, spo:1481279404431773736, lp:1481279413617168475, pp:1481279416016568555, ls:1481279678764552213, ps:1481279731943870654, n:1481279777846591561

# ── Opcjonalne ───────────────────────────────────────────────────────────────

# ID kanału na którym bot wyświetla panel urlopów
VACATION_CHANNEL_ID=

# ID roli "urlop" - nadawana automatycznie gdy gracz deklaruje urlop, zdejmowana po jego zakończeniu
# Stwórz rolę na serwerze (np. 🏖️ Urlop) i wklej jej ID tutaj
VACATION_ROLE_ID=

# ID kanału na którym bot wyświetla panel ankiet (przyciski: Utwórz/Usuń/Przypomnij)
POLL_CHANNEL_ID=

# ── Kick.com powiadomienia o streamie ────────────────────────────────────────

# Sekret webhooka (Settings → Developer w kick.com → Twoja aplikacja → Webhook Secret)
KICK_WEBHOOK_SECRET=

# Slug monitorowanego kanału Kick (np. "nazwakanalu" z kick.com/nazwakanalu)
KICK_CHANNEL_SLUG=

# ID kanału Discord, na który bot wysyła powiadomienia o streamie
KICK_DISCORD_CHANNEL_ID=

# Port HTTP serwera webhook (domyślnie 3001; otwórz go w Oracle Cloud Security List)
KICK_WEBHOOK_PORT=3001

# ── Opcjonalne – automatyczna rejestracja subskrypcji przez Kick API ──────────
# Potrzebne tylko jeśli chcesz, żeby bot sam rejestrował subskrypcje przy starcie.
# Access token uzyskasz przez OAuth 2.1 PKCE flow w portalu dev.kick.com
KICK_ACCESS_TOKEN=
KICK_BROADCASTER_USER_ID=
